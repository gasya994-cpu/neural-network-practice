# Пример файла переменных окружения
# Скопируйте в .env и измените значения

# Базовая директория
BASE_DIR=.

# Каталоги данных
INPUT_DIR=data/input
OUTPUT_DIR=data/output
LOG_DIR=logs

# Логирование
LOG_LEVEL=INFO

# Расширения по умолчанию
DEFAULT_EXTENSIONS=.csv,.png,.jpg,.jpeg

# Размер изображений для нормализации
IMAGE_TARGET_SIZE=64,64
IMAGE_NORMALIZE_FACTOR=255
